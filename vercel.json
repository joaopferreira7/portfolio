{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projeto",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>jornada-do-bem|chronomundi|protocolo-omega)"
        }
      ],
      "destination": "/projetos/:id",
      "permanent": true
    }
  ]
}
